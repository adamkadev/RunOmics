# Env for end-to-end tests (`npm run test:e2e`). Committed on purpose: every
# value here is a placeholder, not a real Firebase project. Firebase web config
# is public by design (it ships in every browser bundle), but a real project id
# still points at real infrastructure, so the e2e run uses a fake one.
#
# No Firebase Admin credentials are needed here: the pages covered by the
# current e2e specs (dashboard, activities, analytics, calendar, records,
# goals, map, shoes, plan) are all built from data/*.json, not
# Firestore. Sign-in-gated flows (Settings, activity notes editing) aren't
# covered yet - see README > "End-to-end tests".

NEXT_PUBLIC_FIREBASE_API_KEY=e2e-placeholder-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=example-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=example-project
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000

# Placeholder: no test signs in as the owner, so this never has to match a
# real account. Auth/write flows are out of scope for the first e2e batch.
NEXT_PUBLIC_OWNER_EMAIL=e2e-owner@example.com

# Deterministic locale for string assertions regardless of the shell's env.
NEXT_PUBLIC_LOCALE=en

# Not set on purpose - both degrade gracefully (map skips rendering, push
# notifications are opt-in via a button, never called on page load):
# NEXT_PUBLIC_MAPTILER_TOKEN=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=
